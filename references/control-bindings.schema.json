{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aaron-he-zhu/aaron-marketing-skills/references/control-bindings.schema.json",
  "title": "Cross-discipline operational control bindings",
  "description": "The central, typed mapping from catalogued skills to compact control-artifact requirements and exact workflow-edge handoffs. An omitted skill is intentionally unbound; an empty bindings object is valid. handoff_requirements is optional for compatibility, but when present it is a non-empty projection over exact graph edge IDs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "authority",
    "catalog_ref",
    "control_artifact_schema",
    "bindings"
  ],
  "properties": {
    "$schema": {"const": "./control-bindings.schema.json"},
    "schema_version": {"const": "1.0"},
    "authority": {"const": "cross-discipline-control-bindings"},
    "catalog_ref": {"const": "references/system-catalog.json"},
    "control_artifact_schema": {"const": "references/control-artifact.schema.json"},
    "bindings": {
      "type": "object",
      "maxProperties": 120,
      "propertyNames": {"$ref": "#/$defs/skillId"},
      "additionalProperties": {"$ref": "#/$defs/binding"}
    },
    "handoff_requirements": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/edgeId"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "uniqueItems": true,
        "items": {"$ref": "#/$defs/controlRequirement"}
      }
    }
  },
  "$defs": {
    "skillId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "edgeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*--[a-z0-9][a-z0-9-]*$"
    },
    "controlRequirement": {
      "enum": [
        "action-intent",
        "action-receipt",
        "artifact-binding",
        "cycle-retro",
        "evidence-observation",
        "measurement-contract"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill_path", "control_requirements"],
      "properties": {
        "skill_path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._/-]+/SKILL\\.md$"
        },
        "control_requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/controlRequirement"}
        }
      }
    }
  }
}
