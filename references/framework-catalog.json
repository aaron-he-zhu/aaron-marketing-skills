{
  "catalog_version": "20.2.0",
  "semantics": {
    "external_validity": "advisory-until-outcome-calibrated",
    "score_states": [
      "pass",
      "partial",
      "fail",
      "unknown",
      "na"
    ],
    "item_points": {
      "pass": 10,
      "partial": 5,
      "fail": 0
    },
    "evidence_types": {
      "measured": 1.0,
      "user-provided": 0.8,
      "calculated": 0.8,
      "estimated": 0.5,
      "proxy": 0.4
    },
    "confidence_factors": {
      "high": 1.0,
      "medium": 0.75,
      "low": 0.5
    },
    "required_coverage": 100,
    "missingness": {
      "unknown": "applicable but not observed; prevents a comparable total score",
      "na": "genuinely inapplicable under an item policy; requires a reason and is excluded",
      "missing": "treated as unknown, never as partial or fail"
    },
    "rounding": "floor",
    "veto_ceiling": 59,
    "multi_veto": {
      "minimum": 2,
      "verdict": "BLOCK",
      "emit_final_score": false
    },
    "bands": [
      {
        "name": "Excellent",
        "minimum": 90,
        "maximum": 100
      },
      {
        "name": "Good",
        "minimum": 75,
        "maximum": 89
      },
      {
        "name": "Medium",
        "minimum": 60,
        "maximum": 74
      },
      {
        "name": "Low",
        "minimum": 40,
        "maximum": 59
      },
      {
        "name": "Poor",
        "minimum": 0,
        "maximum": 39
      }
    ]
  },
