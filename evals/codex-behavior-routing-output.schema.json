{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex semantic behavior blind-routing output",
  "type": "object",
  "additionalProperties": false,
  "required": ["selected_skill"],
  "properties": {
    "selected_skill": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
