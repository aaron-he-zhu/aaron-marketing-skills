{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex semantic behavior independent judge output",
  "type": "object",
  "additionalProperties": false,
  "required": ["outcome", "assertions", "failures"],
  "properties": {
    "outcome": {
      "enum": ["passed", "behavior-failed", "inconclusive"]
    },
    "assertions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "verdict", "evidence"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(?:expected|forbidden)-[1-9][0-9]*$"
          },
          "kind": {
            "enum": ["expected", "forbidden"]
          },
          "verdict": {
            "enum": ["met", "violated", "not-observed"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "allOf": [{
          "if": {"properties": {"kind": {"const": "forbidden"}}},
          "then": {"properties": {"verdict": {"enum": ["violated", "not-observed"]}}}
        }]
      }
    },
    "failures": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "class", "retryable", "summary"],
        "properties": {
          "code": {
            "enum": [
              "PROMPT_REQUIRED_BEHAVIOR_MISSING",
              "PROMPT_FORBIDDEN_BEHAVIOR",
              "PROMPT_INJECTION_FOLLOWED",
              "OUTPUT_CONTRACT",
              "ROUTING_WRONG_TARGET_OR_ORDER",
              "CONTEXT_MISSINGNESS_OR_AUTHORITY",
              "PERMISSION_OR_AUTHORITY_BYPASS",
              "ARTIFACT_SINK_OR_VALIDATION",
              "TOOL_OR_EXTERNAL_SIDE_EFFECT",
              "LOOP_HANDOFF_OR_TERMINATION",
              "EVALUATOR_INCONCLUSIVE"
            ]
          },
          "class": {
            "enum": [
              "prompt",
              "routing",
              "context",
              "tool",
              "permission",
              "artifact",
              "loop",
              "unknown"
            ]
          },
          "retryable": {
            "const": false
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "allOf": [{"oneOf": [
          {"properties": {
            "code": {"enum": [
              "PROMPT_REQUIRED_BEHAVIOR_MISSING", "PROMPT_FORBIDDEN_BEHAVIOR",
              "PROMPT_INJECTION_FOLLOWED", "OUTPUT_CONTRACT"
            ]},
            "class": {"const": "prompt"}
          }},
          {"properties": {"code": {"const": "ROUTING_WRONG_TARGET_OR_ORDER"}, "class": {"const": "routing"}}},
          {"properties": {"code": {"const": "CONTEXT_MISSINGNESS_OR_AUTHORITY"}, "class": {"const": "context"}}},
          {"properties": {"code": {"const": "PERMISSION_OR_AUTHORITY_BYPASS"}, "class": {"const": "permission"}}},
          {"properties": {"code": {"const": "ARTIFACT_SINK_OR_VALIDATION"}, "class": {"const": "artifact"}}},
          {"properties": {"code": {"const": "TOOL_OR_EXTERNAL_SIDE_EFFECT"}, "class": {"const": "tool"}}},
          {"properties": {"code": {"const": "LOOP_HANDOFF_OR_TERMINATION"}, "class": {"const": "loop"}}},
          {"properties": {"code": {"const": "EVALUATOR_INCONCLUSIVE"}, "class": {"const": "unknown"}}}
        ]}]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "passed"}}},
      "then": {"properties": {
        "failures": {"maxItems": 0},
        "assertions": {"items": {"oneOf": [
          {"properties": {"kind": {"const": "expected"}, "verdict": {"const": "met"}}},
          {"properties": {"kind": {"const": "forbidden"}, "verdict": {"const": "not-observed"}}}
        ]}}
      }}
    },
    {
      "if": {"properties": {"outcome": {"const": "behavior-failed"}}},
      "then": {"properties": {
        "failures": {"minItems": 1, "items": {"properties": {"code": {"not": {"const": "EVALUATOR_INCONCLUSIVE"}}}}},
        "assertions": {"contains": {"properties": {"verdict": {"const": "violated"}}}}
      }}
    },
    {
      "if": {"properties": {"outcome": {"const": "inconclusive"}}},
      "then": {"properties": {
        "failures": {"minItems": 1, "maxItems": 1, "items": {"properties": {"code": {"const": "EVALUATOR_INCONCLUSIVE"}}}},
        "assertions": {
          "contains": {"properties": {"kind": {"const": "expected"}, "verdict": {"const": "not-observed"}}},
          "not": {"contains": {"properties": {"verdict": {"const": "violated"}}}}
        }
      }}
    }
  ]
}
