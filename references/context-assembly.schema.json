{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aaron-he-zhu/aaron-marketing-skills/references/context-assembly.schema.json",
  "title": "Aaron consumer-separated context assembly",
  "description": "A metadata-only projection over a verified context manifest. Controller, model, tool, and deferred resources are accounted separately; source bodies remain at hash-anchored paths.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "kind",
    "context_signature",
    "route",
    "profile",
    "deployment_eligible",
    "evaluation_run_id",
    "consumers",
    "replacements",
    "usage",
    "assembly_signature"
  ],
  "properties": {
    "$schema": {"const": "./context-assembly.schema.json"},
    "schema_version": {"const": "1.0"},
    "kind": {"const": "consumer-separated-context-assembly"},
    "context_signature": {"$ref": "#/$defs/sha256"},
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "target_skill"],
      "properties": {
        "command": {"type": "string", "minLength": 1, "maxLength": 32},
        "target_skill": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host_profile",
        "model_id",
        "model_revision",
        "distribution_profile",
        "physical_distribution_kind",
        "planner_distribution_profile",
        "distribution_evaluation_only",
        "distribution_manifest_sha256",
        "prompt_profile",
        "prompt_profile_source",
        "binding_id",
        "always_on_overlays",
        "catalogs"
      ],
      "properties": {
        "host_profile": {"type": "string", "minLength": 1, "maxLength": 96},
        "model_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "model_revision": {
          "oneOf": [
            {"type": "null"},
            {"type": "string", "minLength": 1, "maxLength": 256}
          ]
        },
        "distribution_profile": {"enum": ["repository", "lite", "pro", "governed"]},
        "physical_distribution_kind": {
          "enum": ["repository", "plugin"]
        },
        "planner_distribution_profile": {
          "enum": ["repository", "plugin", "standalone-skill"]
        },
        "distribution_evaluation_only": {"type": "boolean"},
        "distribution_manifest_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "prompt_profile": {"enum": ["explicit", "balanced", "lean"]},
        "prompt_profile_source": {"type": "string", "minLength": 1, "maxLength": 96},
        "binding_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 128}]},
        "always_on_overlays": {
          "const": [
            "consent",
            "claims",
            "pii-secrets",
            "external-mutation",
            "audit-verdict",
            "release-provenance"
          ]
        },
        "catalogs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["host_sha256", "prompt_sha256", "context_modules_sha256"],
          "properties": {
            "host_sha256": {"$ref": "#/$defs/sha256"},
            "prompt_sha256": {"$ref": "#/$defs/sha256"},
            "context_modules_sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "deployment_eligible": {"type": "boolean"},
    "evaluation_run_id": {
      "oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}]
    },
    "consumers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller", "model", "tool", "deferred"],
      "properties": {
        "controller": {"$ref": "#/$defs/resources"},
        "model": {"$ref": "#/$defs/resources"},
        "tool": {"$ref": "#/$defs/resources"},
        "deferred": {"$ref": "#/$defs/resources"}
      }
    },
    "replacements": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_resource_id", "replacement_resource_ids", "reason_code"],
        "properties": {
          "source_resource_id": {"$ref": "#/$defs/safeId"},
          "replacement_resource_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/safeId"}
          },
          "reason_code": {"enum": ["certified-skill-capsule", "certified-policy-kernel"]}
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_selected_bytes",
        "controller_body_bytes",
        "model_body_bytes",
        "tool_body_bytes",
        "deferred_bytes",
        "model_reduction_bytes",
        "model_reduction_ratio"
      ],
      "properties": {
        "manifest_selected_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "controller_body_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "model_body_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "tool_body_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "deferred_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "model_reduction_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "model_reduction_ratio": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "assembly_signature": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\/$)[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_id",
        "scope",
        "path",
        "sha256",
        "bytes",
        "body_bytes",
        "role",
        "module_id",
        "materialization",
        "load_policy",
        "source_resource_id"
      ],
      "properties": {
        "resource_id": {"$ref": "#/$defs/safeId"},
        "scope": {"enum": ["bundle", "project"]},
        "path": {"$ref": "#/$defs/safePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "body_bytes": {"type": "integer", "minimum": 0, "maximum": 10000000},
        "role": {"$ref": "#/$defs/safeId"},
        "module_id": {"$ref": "#/$defs/safeId"},
        "materialization": {"enum": ["body", "metadata", "on-demand"]},
        "load_policy": {"enum": ["always", "activation", "conditional", "lookup-only", "fallback"]},
        "source_resource_id": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/safeId"}]
        }
      }
    },
    "resources": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/resource"}
    }
  }
}
